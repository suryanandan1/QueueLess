# Copy this file to .env and adjust the values.
APP_NAME=QueueLess
ENVIRONMENT=development
DEBUG=true

# SQLite (default, file created next to where uvicorn is started)
DATABASE_URL=sqlite:///./queueless.db
# PostgreSQL example (requires `pip install "psycopg[binary]"`):
# DATABASE_URL=postgresql+psycopg://queueless:queueless@localhost:5432/queueless

# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=2180f9c3b464dcb61bb9cf4f8af8670ef8ccdb0355adc5e4b448e32068b0c68e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
